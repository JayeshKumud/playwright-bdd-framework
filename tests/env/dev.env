# Local runs (the default). Pick another file with TEST_ENV, for example TEST_ENV=ci.
# Any key can be overridden by a real environment variable, or by env/local.env (not committed).

# Application under test (GUI and API share this base URL and one browser context)
BASE_URL=http://127.0.0.1:8000

# Browser
HEADLESS=true
VIEWPORT_WIDTH=1440
VIEWPORT_HEIGHT=900

# Waits, in milliseconds
ACTION_TIMEOUT_MS=10000
NAVIGATION_TIMEOUT_MS=30000
EXPECT_TIMEOUT_MS=10000
TEST_TIMEOUT_MS=120000

# Run
WORKERS=4
RETRIES=0
SCREENSHOT_EVERY_STEP=true

# ActiveMQ (AMQP 1.0). ActiveMQ Classic and Artemis both listen for AMQP on 5672 by default.
MQ_HOST=localhost
MQ_PORT=5672
MQ_USERNAME=admin
MQ_PASSWORD=admin
MQ_RECEIVE_TIMEOUT_MS=10000
# Address prefixes that mark a queue or a topic. ActiveMQ Classic: empty and topic://
# Artemis: set them to match the AMQP acceptor's anycastPrefix / multicastPrefix if it has any.
MQ_QUEUE_PREFIX=
MQ_TOPIC_PREFIX=topic://
