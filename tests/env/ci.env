# CI runs: TEST_ENV=ci. Secrets (MQ_PASSWORD, ...) come from CI variables, which win over this file.
BASE_URL=http://127.0.0.1:8000
HEADLESS=true
VIEWPORT_WIDTH=1440
VIEWPORT_HEIGHT=900
ACTION_TIMEOUT_MS=15000
NAVIGATION_TIMEOUT_MS=45000
EXPECT_TIMEOUT_MS=15000
TEST_TIMEOUT_MS=180000
WORKERS=2
RETRIES=1
SCREENSHOT_EVERY_STEP=true
MQ_HOST=localhost
MQ_PORT=5672
MQ_USERNAME=admin
MQ_PASSWORD=admin
MQ_RECEIVE_TIMEOUT_MS=15000
MQ_QUEUE_PREFIX=
MQ_TOPIC_PREFIX=topic://
